@startchen 03_diagrama_conceptual
' =============================================================================
' MODELO CONCEPTUAL ENTIDAD-RELACION EN NOTACION CHEN (FASE 1)
' Sin claves foraneas migradas (FK) ni tipos fisicos de SGBD.
' Rectangulos = Entidades | Rombos = Relaciones | Ovalos = Atributos
' Atributos subrayados (<<key>>) = Identificadores de negocio conceptuales
' =============================================================================

entity INSTITUCION_EDUCATIVA {
  codigo_dane <<key>>
  nombre_ie
  comuna_localidad
  sector
  calendario
  jornada_predominante
  estado_activa
}

entity COHORTE {
  id_cohorte <<key>>
  anio_lectivo
  jornada
  total_matriculados
}

entity ESTUDIANTE_SEUDONIMO {
  id_estudiante_hash <<key>>
}

entity APOYO_INSTITUCIONAL {
  id_apoyo <<key>>
  tipo_apoyo
  entidad_financiadora
  monto_invertido
  beneficiarios_cubiertos
  fecha_desembolso
}

entity ESCALA_EVALUACION {
  id_escala <<key>>
  nombre_escala
  valor_minimo
  valor_maximo
  permite_decimales
  unidad_medida
}

entity TRANSFORMACION_ESCALA <<associative>> {
  id_transformacion <<key>>
  factor_multiplicador
  constante_desplazamiento
  metodo_justificacion
  vigente
}

entity INSTRUMENTO_EVALUACION {
  id_instrumento <<key>>
  tipo_instrumento
  nombre_instrumento
  fuente_emision
  periodo_aplicacion
}

entity AREA_EVALUACION {
  id_area <<key>>
  codigo_area
  nombre_area
  es_nucleo_comun
}

entity RESULTADO_EVALUACION <<associative>> {
  puntaje_obtenido
  percentil_alcanzado
  nivel_desempeno
  periodo_reporte
  fecha_presentacion
  fecha_registro
}

entity RESULTADO_AGREGADO_IE <<associative>> {
  id_agregado <<key>>
  periodo_reporte
  puntaje_promedio
  desviacion_estandar
  cantidad_evaluados
  fuente_reporte
  fecha_registro
}

entity PROMEDIO_NACIONAL_REF <<associative>> {
  id_referente <<key>>
  anio_vigencia
  puntaje_promedio
  desviacion_estandar
  fuente_oficial
}

entity PLAN_MEJORAMIENTO <<associative>> {
  id_plan <<key>>
  anio_implementacion
  titulo_plan
  diagnostico_base
  meta_cuantitativa
  estado_plan
}

entity SEGUIMIENTO_ACTIVIDAD_PLAN <<weak>> {
  id_seguimiento <<key>>
  nombre_actividad
  fecha_seguimiento
  porcentaje_avance_corte
  observaciones
  estado_actividad
}

entity PARAMETRO_SISTEMA {
  clave_parametro <<key>>
  valor_parametro
  descripcion
  fecha_actualizacion
}

' --- Rombos de Relacion Conceptual (Notacion Chen) ---
relationship ORGANIZA {
}
INSTITUCION_EDUCATIVA -1- ORGANIZA
ORGANIZA -N- COHORTE

relationship AGRUPA {
}
COHORTE -1- AGRUPA
AGRUPA -N- ESTUDIANTE_SEUDONIMO

relationship RECIBE_APOYO {
}
COHORTE -1- RECIBE_APOYO
RECIBE_APOYO -N- APOYO_INSTITUCIONAL

relationship RIGE_ESCALA {
}
ESCALA_EVALUACION -1- RIGE_ESCALA
RIGE_ESCALA -N- INSTRUMENTO_EVALUACION

relationship CONVIERTE_ESCALA {
}
ESCALA_EVALUACION -M- CONVIERTE_ESCALA
CONVIERTE_ESCALA -N- TRANSFORMACION_ESCALA

relationship PRESENTA_EN_AREA {
}
ESTUDIANTE_SEUDONIMO -M- PRESENTA_EN_AREA
INSTRUMENTO_EVALUACION -N- PRESENTA_EN_AREA
AREA_EVALUACION -P- PRESENTA_EN_AREA
PRESENTA_EN_AREA -1- RESULTADO_EVALUACION

relationship CONSOLIDA_EN {
}
COHORTE -M- CONSOLIDA_EN
INSTRUMENTO_EVALUACION -N- CONSOLIDA_EN
AREA_EVALUACION -P- CONSOLIDA_EN
CONSOLIDA_EN -1- RESULTADO_AGREGADO_IE

relationship REFERENCIA_NACIONAL {
}
AREA_EVALUACION -M- REFERENCIA_NACIONAL
ESCALA_EVALUACION -N- REFERENCIA_NACIONAL
REFERENCIA_NACIONAL -1- PROMEDIO_NACIONAL_REF

relationship INTERVIENE_AREA {
}
INSTITUCION_EDUCATIVA -M- INTERVIENE_AREA
AREA_EVALUACION -N- INTERVIENE_AREA
INTERVIENE_AREA -1- PLAN_MEJORAMIENTO

relationship EJECUTA_SEGUIMIENTO <<identifying>> {
}
PLAN_MEJORAMIENTO -1- EJECUTA_SEGUIMIENTO
EJECUTA_SEGUIMIENTO -N- SEGUIMIENTO_ACTIVIDAD_PLAN

@endchen
